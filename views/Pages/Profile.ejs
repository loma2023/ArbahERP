    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script>
          // ===== Tab Switching =====
          function switchTab(btn, tabId) {
            // Remove active from all tabs
            document.querySelectorAll('.profile-tab-btn').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.profile-tab-content').forEach(c => c.classList.remove('active'));

            // Activate clicked tab
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
          }

          // ===== Profile Actions =====
          function saveProfile() {
            const name = document.getElementById('FullName').value;
            const email = document.getElementById('Email').value;

            // Update display
            document.getElementById('ProfileDisplayName').textContent = name;
            document.getElementById('ProfileDisplayEmail').textContent = email;

            alert('تم حفظ البيانات بنجاح! ✅');
          }

          function resetProfile() {
            if (confirm('هل أنت متأكد من إعادة تعيين جميع التغييرات؟')) {
              document.getElementById('FullName').value = 'أحمد محمد عبدالله';
              document.getElementById('Username').value = 'ahmed.mohammed';
              document.getElementById('Email').value = 'ahmed@arbah-erp.com';
              document.getElementById('Phone').value = '0501234567';
              document.getElementById('Role').value = 'admin';
              document.getElementById('Department').value = 'management';
              document.getElementById('City').value = 'الرياض';
              document.getElementById('District').value = 'حي العليا';
              document.getElementById('FullAddress').value = 'شارع التحلية، برج المملكة، الطابق 25';
              document.getElementById('Bio').value = 'مدير نظام ArbahERP مع خبرة 5 سنوات في إدارة الأنظمة المحاسبية والمخزونية.';
              alert('تم إعادة التعيين ✅');
            }
          }

          function changeAvatar() {
            alert('سيتم فتح نافذة اختيار الصورة... 📷');
          }

          function printProfile() {
            window.print();
          }

          function logout() {
            if (confirm('هل أنت متأكد من تسجيل الخروج؟')) {
              alert('تم تسجيل الخروج بنجاح 👋');
              // window.location.href = 'Login.html';
            }
          }

          // ===== Security Actions =====
          function changePassword() {
            const current = document.getElementById('CurrentPassword').value;
            const newPass = document.getElementById('NewPassword').value;
            const confirm = document.getElementById('ConfirmPassword').value;

            if (!current || !newPass || !confirm) {
              alert('يرجى ملء جميع الحقول');
              return;
            }
            if (newPass !== confirm) {
              alert('كلمة المرور الجديدة غير متطابقة');
              return;
            }
            if (newPass.length < 6) {
              alert('كلمة المرور يجب أن تكون 6 أحرف على الأقل');
              return;
            }

            alert('تم تغيير كلمة المرور بنجاح! 🔒');
            document.getElementById('CurrentPassword').value = '';
            document.getElementById('NewPassword').value = '';
            document.getElementById('ConfirmPassword').value = '';
          }

          function toggle2FA() {
            alert('تم تبديل حالة المصادقة الثنائية');
          }

          function toggleBiometric() {
            alert('تم تبديل حالة التسجيل البيومتري');
          }

          function changeSessionTimeout() {
            const minutes = prompt('أدخل عدد الدقائق:', '30');
            if (minutes) {
              alert('تم تعيين مهلة الجلسة إلى ' + minutes + ' دقيقة');
            }
          }

          function manageAPIKeys() {
            alert('سيتم فتح صفحة إدارة مفاتيح API');
          }

          function logoutSession(btn) {
            if (confirm('هل أنت متأكد من إنهاء هذه الجلسة؟')) {
              const sessionItem = btn.closest('.session-item');
              sessionItem.style.opacity = '0.5';
              sessionItem.style.transform = 'translateX(20px)';
              setTimeout(() => sessionItem.remove(), 300);
            }
          }

          // ===== Notifications =====
          function saveNotifications() {
            alert('تم حفظ إعدادات الإشعارات بنجاح! 🔔');
          }

          function resetNotifications() {
            if (confirm('هل أنت متأكد من إعادة تعيين إعدادات الإشعارات؟')) {
              document.querySelectorAll('#tab-notifications .toggle-switch input').forEach(input => {
                input.checked = false;
              });
              document.querySelectorAll('#tab-notifications .toggle-switch input')[0].checked = true;
              document.querySelectorAll('#tab-notifications .toggle-switch input')[1].checked = true;
              document.querySelectorAll('#tab-notifications .toggle-switch input')[2].checked = true;
              document.querySelectorAll('#tab-notifications .toggle-switch input')[4].checked = true;
              alert('تم إعادة التعيين ✅');
            }
          }

          // ===== Keyboard Shortcuts =====
          document.addEventListener('keydown', function (e) {
            if (e.ctrlKey && e.key === 's') {
              e.preventDefault();
              saveProfile();
            }
          });
        </script>
</body>

</html>