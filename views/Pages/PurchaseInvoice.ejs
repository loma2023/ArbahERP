<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2>☻ فاتورة مشتريات جديدة</h2>
            <p></p>
          </div>

          <div class="Details-Receipt">
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>رقم الفاتورة</label>
                <div class="input">
                  <input type="text" value="26-0001" disabled="">
                  <i class="fa-solid fa-hashtag"></i>
                </div>
              </div>
              <div class="Field">
                <label>الرقم المرجعي</label>
                <div class="input">
                  <input type="text" id="ReferenceNumber" placeholder="أدخل الرقم المرجعي للمورد">
                  <i class="fa-solid fa-hashtag"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Details-Receipt-Column-Grid">
                <div class="Field">
                  <label>تاريخ الفاتورة</label>
                  <div class="input">
                    <input type="date" id="SalesDate">
                    <i class="fa-solid fa-calendar"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>تاريخ الاستحقاق</label>
                  <div class="input">
                    <input type="date" id="DueDate">
                    <i class="fa-solid fa-calendar-check"></i>
                  </div>
                </div>
              </div>
              <!-- ✅ الموردين - بدون onclick events -->
              <div class="Field" data-select="supplier">
                <label>اسم المورد</label>
                <div class="input SelectInput">
                  <input type="text" class="select-search" placeholder="..." autocomplete="off">
                  <input type="hidden" class="select-value" id="SupplierId">
                  <i class="fa fa-user select-icon"></i>
                </div>
                <div class="SelectOptionDropdown">
                  <div class="select-content"></div>
                </div>
              </div>
            </div>

            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>اسم المندوب</label>
                <div class="input SelectInput">
                  <select id="SalesRep">
                    <option value="">اختر المندوب...</option>
                    <option value="1">REP-001 - أحمد محمد</option>
                    <option value="2">REP-002 - خالد عبدالله</option>
                    <option value="3">REP-003 - سعيد علي</option>
                  </select>
                  <i class="fa-solid fa-user-tie"></i>
                </div>
              </div>
              <div class="Field">
                <label>مركز التكلفة</label>
                <div class="input SelectInput">
                  <select id="CostCenter">
                    <option value="">اختر مركز التكلفة...</option>
                    <option value="main">CC-001 - المستودع الرئيسي</option>
                    <option value="riyadh">CC-002 - فرع الرياض</option>
                    <option value="jeddah">CC-003 - فرع جدة</option>
                  </select>
                  <i class="fa-solid fa-sitemap"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>الفرع</label>
                <div class="input SelectInput">
                  <select id="Branch">
                    <option value="">اختر الفرع...</option>
                    <option value="transfer">فرع الشعبي</option>
                    <option value="transfer">فرع الزهور</option>
                    <option value="transfer">فرع المبرز</option>
                  </select>
                  <i class="fa-solid fa-location-dot"></i>
                </div>
              </div>
              <div class="Field">
                <label>المخزن</label>
                <div class="input SelectInput">
                  <select id="Warehouse">
                    <option value="">اختر المخزن...</option>
                    <option value="main">WH-001 - المستودع الرئيسي</option>
                    <option value="shaabi">WH-002 - مخزن الشعبي</option>
                    <option value="ahsa">WH-003 - مخزن الأحساء</option>
                  </select>
                  <i class="fa-solid fa-warehouse"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>طريقة الدفع</label>
                <div class="input SelectInput">
                  <select id="PaymentMethod" onchange="handlePaymentMethodChange()">
                    <option value="cash">نقداً</option>
                    <option value="transfer">تحويل بنكي</option>
                    <option value="partial">جزئي</option>
                    <option value="credit">آجل</option>
                  </select>
                  <i class="fa-solid fa-money-bill"></i>
                </div>
              </div>
              <div class="Field" id="CashBoxField" style="display: block;">
                <label>الخزينة / الصندوق</label>
                <div class="input SelectInput">
                  <select id="CashBoxSelect">
                    <option value="">اختر الصندوق...</option>
                    <option value="cash-main">1001 - الخزينة الرئيسية</option>
                    <option value="cash-riyadh">1002 - خزينة فرع الرياض</option>
                    <option value="cash-jeddah">1003 - خزينة فرع جدة</option>
                  </select>
                  <i class="fa-solid fa-box"></i>
                </div>
              </div>
              <div class="Field" id="BankField" style="display: none;">
                <label>البنك</label>
                <div class="input SelectInput">
                  <select id="BankSelect">
                    <option value="">اختر البنك...</option>
                    <option value="bank-ahli">1010 - البنك الأهلي</option>
                    <option value="bank-rajhi">1011 - بنك الراجحي</option>
                  </select>
                  <i class="fa-solid fa-building-columns"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="Container-Table Container-Table-Receipt">
            <div class="Container-Table-Header">
              <div class="Container-AddItem">
                <div class="xxxxxxx">
                  <div class="Field">
                    <div class="input">
                      <input type="text" id="QuickSearchItem" placeholder="ابحث باسم الصنف أو الباركود...">
                      <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                  </div>
                  <button class="Tool-Btn btn-add-item" onclick="openPopUpWindow('AddNewPopup');">
                    <i class="fa-solid fa-plus"></i> إضافة صنف
                  </button>
                </div>
                <div class="xxxxxxx PriceType">
                  <div class="Field price-includes-tax-field">
                    <div class="input SelectInput">
                      <select id="PriceIncludesTax" onchange="handlePriceIncludesTaxChange()">
                        <option value="false" selected="">السعر بدون ضريبة</option>
                        <option value="true">السعر شامل الضريبة</option>
                      </select>
                      <i class="fa-solid fa-percent"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="InvoiceTable">
                <thead>
                  <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 22%;">اسم الصنف</th>
                    <th style="width: 10%;">الوحدة</th>
                    <th style="width: 7.5%;">الكمية</th>
                    <th style="width: 7.5%;">السعر</th>
                    <th style="width: 7.5%;">الإجمالي</th>
                    <th style="width: 7.5%;">خصم %</th>
                    <th style="width: 7.5%;">خصم قيمة</th>
                    <th style="width: 7.5%;">ضريبة %</th>
                    <th style="width: 7.5%;">الضريبة</th>
                    <th style="width: 7.5%;">الصافي</th>
                    <th style="width: 5%;">حذف</th>
                  </tr>
                </thead>
                <tbody id="InvoiceTableBody">
                  <tr>
                    <td onclick="openPopUpWindow('AddNewPopup'); setTimeout(initInvoicePopup, 100);" colspan="12"
                      class="NotFound">لا
                      توجد أصناف في الفاتورة. اضغط "إضافة صنف" او F1 للبدء</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span id="ItemsCount">عدد الأصناف: 0</span>
            </div>
          </div>

          <div class="Control-bar Control-bar-Receipt">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-calculator"></i></div>
                <div class="info-text">
                  <span class="lbl">الإجمالي الفرعي</span>
                  <input type="text" id="SubTotal" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-tag"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي الخصومات</span>
                  <input type="text" id="TotalDiscount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-percent"></i></div>
                <div class="info-text">
                  <span class="lbl">خصم عام %</span>
                  <input type="number" id="DiscountPercent" class="num" value="0" min="0" max="100"
                    onchange="calculateTotals()">
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-receipt"></i></div>
                <div class="info-text">
                  <span class="lbl">قيمة الخصم</span>
                  <input type="text" id="DiscountAmount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-receipt"></i></div>
                <div class="info-text">
                  <span class="lbl">بعد الخصم</span>
                  <input type="text" id="TotalAfterDiscount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-percent"></i></div>
                <div class="info-text">
                  <span class="lbl">الضريبة</span>
                  <input type="text" id="TaxAmount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-wallet"></i></div>
                <div class="info-text">
                  <span class="lbl">الإجمالي النهائي</span>
                  <input type="text" id="GrandTotal" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-money-bill"></i></div>
                <div class="info-text">
                  <span class="lbl">المدفوع</span>
                  <input type="number" id="PaidAmount" class="num" value="0" min="0" step="1"
                    onchange="calculateTotals()" readonly=""
                    style="background: var(--bg-hover); color: var(--text-sub);">
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-circle-exclamation"></i></div>
                <div class="info-text">
                  <span class="lbl">المتبقي</span>
                  <input type="text" id="RemainingAmount" class="num" value="0.00" readonly=""
                    style="color: var(--accent-red);">
                </div>
              </div>
            </div>

            <div class="action-buttons-group">
              <button class="Tool-Btn btn-print" onclick="printInvoiceFromPage()"><i class="fa-solid fa-print"></i>
                طباعة</button>
              <button class="Tool-Btn btn-delete-selected" onclick="clearAllItems()"><i
                  class="fa-solid fa-trash-can"></i>
                إفراغ</button>
              <button class="Tool-Btn btn-save" onclick="saveInvoice()"><i class="fa-solid fa-save"></i> حفظ
                الفاتورة</button>
            </div>
          </div>
        </main>
    </div>

    <div class="Container-PopUp-Window" id="AddNewPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3>اختيار صنف من المخزون</h3>
            <p>ابحث عن الصنف واختره لإضافته للفاتورة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddNewPopup')">
            <i class="fa fa-xmark"></i></button>
          </button>
        </div>
        <div class="PopUpWindow-Body">
          <div class="Search-Box">
            <div class="Field">
              <div class="input">
                <input type="text" id="ItemSearchInput" placeholder="ابحث باسم الصنف أو الباركود أو الكود..."
                  onkeyup="searchItems()">
                <i class="fa-solid fa-magnifying-glass"></i>
              </div>
            </div>
          </div>
          <div class="Container-Table-Body">
            <table class="Perfect-Table" id="ItemsTable">
              <thead>
                <tr>
                  <th style="width: 4%;">
                    <input type="checkbox" id="SelectAllItems" onchange="toggleSelectAll()">
                  </th>
                  <th style="width: 10%;">#</th>
                  <th style="width: 14%;">كود الصنف</th>
                  <th style="width: 30%;">اسم الصنف</th>
                  <th style="width: 14%;">الوحدة</th>
                  <th style="width: 14%;">السعر</th>
                  <th style="width: 14%;">المخزون</th>
                </tr>
              </thead>
              <tbody id="ItemsTableBody"></tbody>
            </table>
          </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddNewPopup')"><i class="fa fa-xmark"></i> إلغاء</button>
          <button class="apply" onclick="addSelectedItem()" id="AddSelectedBtn" disabled="">
            <i class="fa fa-plus"></i> إضافة المختار (<span id="SelectedCount">0</span>)
          </button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>
        <!-- <script src="/Js/PurchaseInvoice.js"></script> -->

</body>

</html>