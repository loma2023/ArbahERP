        <script>
          // Settlement popup functions
          function openSettlementPopup(advanceId) {
            // Here you would fetch the advance data and populate the stats
            document.getElementById('SettlementAdvanceId').value = advanceId;
            document.getElementById('SettlementDate').value = new Date().toISOString().split('T')[0];

            // Mock data - replace with actual data fetch
            const mockData = {
              1: { total: 5000, paid: 5000, remaining: 0 },
              2: { total: 10000, paid: 3000, remaining: 7000 },
              3: { total: 8000, paid: 0, remaining: 8000 },
              4: { total: 15000, paid: 0, remaining: 15000 }
            };

            const data = mockData[advanceId] || { total: 0, paid: 0, remaining: 0 };
            document.getElementById('SettlementTotal').textContent = data.total.toLocaleString() + ' ر.س';
            document.getElementById('SettlementPaid').textContent = data.paid.toLocaleString() + ' ر.س';
            document.getElementById('SettlementRemaining').textContent = data.remaining.toLocaleString() + ' ر.س';

            openPopUpWindow('SettlementPopup');
          }

          function openSettlementPopupFromDetails() {
            const advanceId = document.getElementById('DetailsCode').dataset.id;
            openSettlementPopup(advanceId);
          }

          function saveSettlement() {
            const amount = document.getElementById('SettlementAmount').value;
            const date = document.getElementById('SettlementDate').value;
            const method = document.getElementById('SettlementMethod').value;
            const ref = document.getElementById('SettlementRef').value;
            const notes = document.getElementById('SettlementNotes').value;

            if (!amount || amount <= 0) {
              showToast('يرجى إدخال مبلغ التسوية', 'error');
              return;
            }

            // Here you would send the data to the server
            showToast('تم حفظ التسوية بنجاح', 'success');
            closePopUpWindow('SettlementPopup');
          }

          function saveAdvance() {
            const code = document.getElementById('AdvanceCode').value;
            const date = document.getElementById('AdvanceDate').value;
            const employee = document.getElementById('AdvanceEmployee').value;
            const amount = document.getElementById('AdvanceAmount').value;
            const dueDate = document.getElementById('AdvanceDueDate').value;
            const purpose = document.getElementById('AdvancePurpose').value;

            if (!employee) {
              showToast('يرجى اختيار الموظف', 'error');
              return;
            }
            if (!amount || amount <= 0) {
              showToast('يرجى إدخال المبلغ', 'error');
              return;
            }

            showToast('تم حفظ العهدة بنجاح', 'success');
            closePopUpWindow('AddNewPopup');
          }

