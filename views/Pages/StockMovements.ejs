<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2>☻ حركة المخزون</h2>
            <p>تتبع حركات المخزون (وارد - صادر - تحويل - تسوية)</p>
          </div>

          <div class="info-banner">
            <i class="fa-solid fa-circle-info"></i>
            <span><strong>ملاحظة:</strong> الوارد يأتي تلقائياً من فواتير المشتريات، والصادر من فواتير المبيعات.
              التحويل والتسوية يدوية.</span>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row" style="grid-template-columns: repeat(4, 1fr);">
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-box-open"></i></div>
                <div class="info-text">
                  <span class="lbl">الأصناف النشطة</span>
                  <span class="num" id="ActiveItems">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <div class="info-text">
                  <span class="lbl">تحت الحد الأدنى</span>
                  <span class="num" id="LowStockItems">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-warehouse"></i></div>
                <div class="info-text">
                  <span class="lbl">المستودعات</span>
                  <span class="num" id="TotalWarehouses">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-rotate"></i></div>
                <div class="info-text">
                  <span class="lbl">حركات اليوم</span>
                  <span class="num" id="TodayMovements">0</span>
                </div>
              </div>
            </div>


          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="MainPerfectTable">
                <thead>
                  <tr>
                    <th style="width: 3%">#</th>
                    <th style="width: 12%;">
                      <div class="th-content">رقم العملية <i class="fa-solid fa-filter Filter-Btn" data-columnindex="1"
                          data-columnname="docNumber"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">النوع <i class="fa-solid fa-filter Filter-Btn" data-columnindex="2"
                          data-columnname="type"></i></div>
                    </th>
                    <th style="width: 16%;">
                      <div class="th-content">الصنف <i class="fa-solid fa-filter Filter-Btn" data-columnindex="3"
                          data-columnname="itemName"></i></div>
                    </th>
                    <th style="width: 8%;">
                      <div class="th-content">الكمية <i class="fa-solid fa-filter Filter-Btn" data-columnindex="4"
                          data-columnname="quantity"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">الرصيد <i class="fa-solid fa-filter Filter-Btn" data-columnindex="5"
                          data-columnname="balance"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">المستودع <i class="fa-solid fa-filter Filter-Btn" data-columnindex="6"
                          data-columnname="warehouse"></i></div>
                    </th>
                    <th style="width: 14%;">
                      <div class="th-content">المصدر <i class="fa-solid fa-filter Filter-Btn" data-columnindex="7"
                          data-columnname="sourceDoc"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">التاريخ <i class="fa-solid fa-filter Filter-Btn" data-columnindex="8"
                          data-columnname="date"></i></div>
                    </th>
                    <th style="width: 5%;">الإجراء</th>
                  </tr>
                </thead>
                <tbody id="StockMovementTable">

                </tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span class="info-text" id="showingDataMetrics">عرض 1-10 من 20</span>
              <div id="PaginationPages" class="Pagination-Pages"></div>
            </div>
          </div>
        </main>
    </div>


    <div class="Container-PopUp-Window" id="AddNewPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle">تسوية مخزون</h3>
            <p id="PopupSubtitle">تعديل الرصيد بعد الجرد</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddNewPopup')">
            <i class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <form id="MovementForm">
            <input type="hidden" id="MovementId" value="">
            <input type="hidden" id="MovementType" value="adjust">

            <div class="Form-Section">
              <h4><i class="fa fa-file-invoice"></i> البيانات الأساسية</h4>
              <div class="grid">
                <div class="Field">
                  <label>رقم التسوية</label>
                  <div class="input"><input type="text" id="DocNumber" disabled=""><i class="fa fa-hashtag"></i></div>
                </div>
                <div class="Field">
                  <label>التاريخ</label>
                  <div class="input"><input type="date" id="MovementDate"><i class="fa fa-calendar"></i>
                  </div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-box"></i> الصنف</h4>
              <div class="grid">
                <div class="Field">
                  <label>الصنف</label>
                  <div class="input SelectInput">
                    <select id="ItemSelect">
                      <option value="">اختر الصنف...</option>
                      <option value="1">ITM-001 - لابتوب Dell Latitude 5520</option>
                      <option value="2">ITM-002 - ماوس لاسلكي Logitech</option>
                      <option value="3">ITM-003 - كيبورد ميكانيكي Redragon</option>
                      <option value="4">ITM-004 - شاشة Samsung 27 بوصة</option>
                      <option value="5">ITM-005 - طابعة HP LaserJet</option>
                      <option value="6">ITM-006 - راوتر TP-Link AC1200</option>
                      <option value="7">ITM-007 - هارد ديسك خارجي 2TB</option>
                      <option value="8">ITM-008 - بطارية لابتوب Dell</option>
                      <option value="9">ITM-009 - كابل HDMI 2 متر</option>
                      <option value="10">ITM-010 - سماعات رأس JBL</option>
                    </select>
                    <i class="fa fa-box"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>الكمية (موجب للزيادة، سالب للنقصان)</label>
                  <div class="input"><input type="number" id="MovementQuantity" placeholder="0" min="-999"><i
                      class="fa fa-hashtag"></i></div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-warehouse"></i> المستودع</h4>
              <div class="grid">
                <div class="Field">
                  <label>المستودع</label>
                  <div class="input SelectInput">
                    <select id="WarehouseSelect">
                      <option value="main">المستودع الرئيسي</option>
                      <option value="riyadh">مستودع الرياض</option>
                      <option value="jeddah">مستودع جدة</option>
                      <option value="dammam">مستودع الدمام</option>
                    </select>
                    <i class="fa fa-warehouse"></i>
                  </div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-pen"></i> ملاحظات</h4>
              <div class="Field">
                <div class="input">
                  <textarea id="MovementNotes" placeholder="سبب التسوية..."></textarea>
                  <i class="fa fa-pen icon-area"></i>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddNewPopup')"><i class="fa fa-xmark"></i> إلغاء</button>
          <button class="apply" onclick="saveMovement()"><i class="fa fa-save"></i> حفظ التسوية</button>
        </div>
      </div>
    </div>

    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window">
        <div class="PopUpWindow-Header">
          <div class="PopUpWindow-Title">
            <h3>تفاصيل الصنف</h3>
            <p><i class="fa-solid fa-hashtag"></i>
              <span id="DetailsCode">PROD-001</span>
            </p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')"><i
              class="fa fa-xmark"></i></button>
        </div>

        <div class="PopUpWindow-Body" id="VoucherDetailsBody">
          <div class="voucher-details-container">
            <div class="Watermark">تفاصيل حركة </div>

            <%- include('../Partials/letterHead') %>

              <div class="Title-Voucher">تفاصيل حركة</div>
              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue">
                    <i class="fa-solid fa-credit-card"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">رقم الحركة</div>
                    <div class="voucher-info-value">IN-0001 </div>
                  </div>
                </div>

                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple">
                    <i class="fa-solid fa-building-columns"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">تاريخ الحركة</div>
                    <div class="voucher-info-value">2026-06-21</div>
                  </div>
                </div>

                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-cyan">
                    <i class="fa-solid fa-hashtag"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">نوع الحركة</div>
                    <div class="voucher-info-value">وارد</div>
                  </div>
                </div>
              </div>

              <div class="voucher-info-grid">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-red">
                    <i class="fa-solid fa-building"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">اسم الصنف </div>
                    <div class="voucher-info-value">زيت تنك الجميل 10 لتر</div>
                    <div class="voucher-info-label">SUP-001</div>
                  </div>
                </div>
              </div>

              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue">
                    <i class="fa-solid fa-credit-card"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الكمية </div>
                    <div class="voucher-info-value">3000 </div>
                  </div>
                </div>

                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple">
                    <i class="fa-solid fa-building-columns"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الرصيد</div>
                    <div class="voucher-info-value">2000</div>
                  </div>
                </div>

                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-cyan">
                    <i class="fa-solid fa-hashtag"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المستودع</div>
                    <div class="voucher-info-value">المستودع الرئيسي</div>
                  </div>
                </div>
              </div>

              <div class="LetterFoot">
                <div class="Footer-Left">
                  <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                  <span>تم إنشاؤها بواسطة: إسلام عبدالرحمن ابراهيم عبدالنعيم | 2024/06/09 14:30:25</span>
                </div>
                <div class="Footer-Pages">صفحة 1 من 1</div>
              </div>

          </div>
        </div>

        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i>
            إغلاق</button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa-solid fa-print"></i>
            طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="Js/StockMove.js"></script>

</body>

</html>