<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-building-columns"></i> الميزانية العمومية</h2>
            <p>الأصول = الخصوم + حقوق الملكية</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-building-columns"></i></div>
                <div class="info-text">
                  <span class="lbl">الأصول</span>
                  <span class="num value" id="TotalAssets">0.00 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                <div class="info-text">
                  <span class="lbl">الخصوم</span>
                  <span class="num value" id="TotalLiabilities">0.00 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-chart-pie"></i></div>
                <div class="info-text">
                  <span class="lbl">حقوق الملكية</span>
                  <span class="num value" id="TotalEquity">0.00 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-chart-pie"></i></div>
                <div class="info-text">
                  <span class="lbl">الحالة</span>
                  <span class="num value" id="BalanceCheck">.</span>
                </div>
              </div>
            </div>
          </div>

          <div class="Filter-bar">
            <div class="Field">
              <label>تاريخ التقرير</label>
              <div class="input">
                <input type="date" id="ReportDate" value="<%= new Date().toISOString().split('T')[0] %>">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>مقارنة بتاريخ</label>
              <div class="input">
                <input type="date" id="CompareDate"
                  value="<%= new Date(new Date().getFullYear()-1, 11, 31).toISOString().split('T')[0] %>">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <button class="Tool-Btn btn-excel" onclick="generateBalanceSheet()">
              <i class="fa-solid fa-refresh"></i> تحديث
            </button>
            <button class="Tool-Btn btn-excel" onclick="openPrintPopup()">
              <i class="fa-solid fa-print"></i> طباعة الكشف
            </button>
            <button class="Tool-Btn btn-excel" onclick="exportExcel()">
              <i class="fa-solid fa-file-excel"></i> Excel
            </button>
          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body" style="height: 90vh;">
              <table class="Perfect-Table" id="BalanceSheetTable">
                <thead>
                  <tr>
                    <th>الكود</th>
                    <th>البيان</th>
                    <th>الرصيد الحالي</th>
                    <th>مقارنة</th>
                    <th>التغير</th>
                    <th>نسبة التغير</th>
                  </tr>
                </thead>
                <tbody id="BalanceSheetBody">
                  <tr>
                    <td colspan="4" class="loading-cell">
                      <div class="loading-spinner"></div>
                      <div>جاري التحميل...</div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </main>
    </div>

    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window" style="width: 1000px; max-width: 98vw;">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle"><i class="fa-solid fa-book-open"></i> قائمة المركز المالي</h3>
            <p id="PopupSubtitle">معاينة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')">
            <i class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <div class="Watermark">قائمة المركز المالي</div>

          <%- include('../Partials/letterHead') %>

            <div class="Title-Voucher">قائمة المركز المالي</div>

            <!-- رأس كشف الحساب -->
            <!-- كروت الملخص -->
            <div class="voucher-info-grid Grid-2">
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-blue">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">تاريخ التقرير</div>
                  <div class="voucher-info-value" id="DetailsFromDate">01-01-2026</div>
                </div>
              </div>
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-purple">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">تاريخ المقارنة</div>
                  <div class="voucher-info-value" id="DetailsToDate">31-12-2026</div>
                </div>
              </div>
            </div>

            <!-- جدول كشف الحساب -->
            <div class="Container-Table2">
              <table class="Perfect-Table ledger-print-table" id="LedgerPrintTable">
                <thead>
                  <tr>
                    <th>الكود</th>
                    <th>البيان</th>
                    <th>الرصيد الحالي</th>
                    <th>مقارنة</th>
                    <th>التغير</th>
                    <th>نسبة التغير</th>
                  </tr>
                </thead>
                <tbody id="BalanceSheetPrintBody">
                  <!-- يملأها JS -->
                </tbody>
              </table>
            </div>

            <div class="LetterFoot">
              <div class="Footer-Left">
                <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                <span id="DetailsFooterInfo"></span>
              </div>
              <div class="Footer-Pages" id="TimeDate"></div>
            </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i> إغلاق</button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa-solid fa-print"></i> طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="/Js/BalanceSheet.js"></script>
</body>

</html>