<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-money-bill-transfer"></i> تقرير التدفقات النقدية</h2>
            <p>تحليل حركة النقدية للفترة المالية المحددة</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-green operating">
                <div class="icon-box"><i class="fa-solid fa-cogs"></i></div>
                <div class="info-text">
                  <span class="lbl">التشغيل</span>
                  <span class="num value" id="OperatingCF">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue investing">
                <div class="icon-box"><i class="fa-solid fa-chart-line"></i></div>
                <div class="info-text">
                  <span class="lbl">الاستثمار</span>
                  <span class="num value" id="InvestingCF">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple financing">
                <div class="icon-box"><i class="fa-solid fa-landmark"></i></div>
                <div class="info-text">
                  <span class="lbl">التمويل</span>
                  <span class="num value" id="FinancingCF">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-orange net">
                <div class="icon-box"><i class="fa-solid fa-wallet"></i></div>
                <div class="info-text">
                  <span class="lbl">صافي التدفق</span>
                  <span class="num value" id="NetCF">0</span>
                </div>
              </div>
            </div>
          </div>

          <div class="Filter-bar">
            <div class="Field">
              <label>من تاريخ</label>
              <div class="input"><input type="date" id="FromDate" value="2026-01-01"><i
                  class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>إلى تاريخ</label>
              <div class="input"><input type="date" id="ToDate" value="2026-06-30"><i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>طريقة العرض</label>
              <div class="input SelectInput">
                <select id="MethodSelect">
                  <option value="indirect">الطريقة غير المباشرة</option>
                  <option value="direct">الطريقة المباشرة</option>
                </select>
                <i class="fa-solid fa-list"></i>
              </div>
            </div>
            <button class="Tool-Btn btn-excel" onclick="generateCashFlow()"><i class="fa-solid fa-refresh"></i>
              تحديث</button>
            <button class="Tool-Btn btn-excel" onclick="openPrintPopup()">
              <i class="fa-solid fa-print"></i> طباعة الكشف
            </button>
            <button class="Tool-Btn btn-excel" onclick="exportExcel()"><i class="fa-solid fa-file-excel"></i>
              Excel</button>
          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body" style="height: 90vh;">
              <table class="Perfect-Table" id="CashFlowTable">
                <thead>
                  <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 55%;">البيان</th>
                    <th style="width: 20%;">النشاط</th>
                    <th style="width: 20%;">المبلغ</th>
                  </tr>
                </thead>
                <tbody id="CashFlowBody">
                  <tr>
                    <td colspan="4" class="loading-cell">
                      <div class="loading-spinner"></div>
                      <div>جاري التحميل...</div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </main>
    </div>

  <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window" style="width: 1000px; max-width: 98vw;">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle"><i class="fa-solid fa-book-open"></i> قائمة التدفقات النقدية</h3>
            <p id="PopupSubtitle">معاينة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')">
            <i class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <div class="Watermark">قائمة التدفقات النقدية </div>

          <%- include('../Partials/letterHead') %>

            <div class="Title-Voucher">قائمة التدفقات النقدية </div>

            <!-- رأس كشف الحساب -->
            <!-- كروت الملخص -->
            <div class="voucher-info-grid Grid-2">
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-blue">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">تاريخ التقرير</div>
                  <div class="voucher-info-value" id="DetailsFromDate">01-01-2026</div>
                </div>
              </div>
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-purple">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">تاريخ المقارنة</div>
                  <div class="voucher-info-value" id="DetailsToDate">31-12-2026</div>
                </div>
              </div>
            </div>

            <!-- جدول كشف الحساب -->
            <div class="Container-Table2">
              <table class="Perfect-Table ledger-print-table" id="LedgerPrintTable">
                <thead>
                  <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 55%;">البيان</th>
                    <th style="width: 20%;">النشاط</th>
                    <th style="width: 20%;">المبلغ</th>
                  </tr>
                </thead>
                <tbody id="CashFlowPrintBody">
                  <!-- يملأها JS -->
                </tbody>
              </table>
            </div>

            <div class="LetterFoot">
              <div class="Footer-Left">
                <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                <span id="DetailsFooterInfo"></span>
              </div>
              <div class="Footer-Pages" id="TimeDate"></div>
            </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i> إغلاق</button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa-solid fa-print"></i> طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="/Js/CashFlow.js"></script>
</body>

</html>