    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>
        <script>
          // =============================================
          // Simple Navigation - Click group = show content
          // =============================================

          function showGroupSection(sectionId, headerElement) {
            // Hide all content sections
            document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));

            // Show target section
            const targetSection = document.getElementById('section-' + sectionId);
            if (targetSection) targetSection.classList.add('active');

            // Reset all sidebar highlights
            document.querySelectorAll('.sidebar-group').forEach(g => g.classList.remove('active-group'));
            document.querySelectorAll('.sidebar-group-header').forEach(h => h.classList.remove('active'));

            // Highlight clicked group
            const group = headerElement.closest('.sidebar-group');
            if (group) {
              group.classList.add('active-group');
              headerElement.classList.add('active');
            }
          }

          function selectColor(element, color) {
            document.querySelectorAll('.color-option').forEach(c => c.classList.remove('active'));
            element.classList.add('active');
          }

          function addUser() {
            const name = document.getElementById('NewUserName').value;
            if (!name) { alert('يرجى إدخال اسم المستخدم'); return; }
            ArbahToast.success('تم إضافة المستخدم: ' + name)

            document.getElementById('NewUserName').value = '';
            document.getElementById('NewUserEmail').value = '';
            document.getElementById('NewUserPhone').value = '';
          }

          function createBackup() {
            ArbahToast.info('جاري إنشاء نسخة احتياطية...\n\nسيتم إشعارك عند الانتهاء.')
          }

          function saveSettings() {
            ArbahToast.success('تم حفظ الإعدادات بنجاح!')

          }

          function resetSettings() {
            if (confirm('هل أنت متأكد من إعادة تعيين جميع الإعدادات؟')) {
              alert('تم إعادة تعيين الإعدادات إلى الوضع الافتراضي.');
            }
          }

          // Initialize - show company section by default
          document.addEventListener('DOMContentLoaded', function () {
            const firstGroup = document.querySelector('.sidebar-group');
            if (firstGroup) {
              const header = firstGroup.querySelector('.sidebar-group-header');
              const items = firstGroup.querySelector('.sidebar-items');
              const sectionId = firstGroup.getAttribute('data-section');

              if (header) header.classList.add('active');
              if (items) items.classList.add('expanded');
              firstGroup.classList.add('active-group');

              // Show the first section
              if (sectionId) {
                const targetSection = document.getElementById('section-' + sectionId);
                if (targetSection) targetSection.classList.add('active');
              }
            }
          });
        </script>
</body>

