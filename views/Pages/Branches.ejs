<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2>☻ تعريف الفروع</h2>
            <p>إدارة فروع الشركة والمخازن المرتبطة بكل فرع</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-building"></i></div>
                <div class="info-text">
                  <span class="lbl">عدد الفروع</span>
                  <span class="num" id="TotalBranches">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-circle-check"></i></div>
                <div class="info-text">
                  <span class="lbl">النشطة</span>
                  <span class="num" id="ActiveBranches">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-pause"></i></div>
                <div class="info-text">
                  <span class="lbl">غير النشطة</span>
                  <span class="num" id="InactiveBranches">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-lock"></i></div>
                <div class="info-text">
                  <span class="lbl">المغلقة</span>
                  <span class="num" id="ClosedBranches">0</span>
                </div>
              </div>
            </div>

            <div class="action-buttons-group">
              <button class="Tool-Btn btn-add-customer" onclick="openPopUpWindow('AddNewPopup'); resetForm();"><i
                  class="fa-solid fa-plus"></i> إضافة فرع</button>
              <button class="Tool-Btn btn-excel" onclick="exportBranchesExcel()"><i class="fa-solid fa-file-excel"></i>
                تصدير Excel</button>
            </div>
          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="MainPerfectTable">
                <thead>
                  <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 18%;">
                      <div class="th-content">الفرع <i class="fa-solid fa-filter Filter-Btn" data-columnindex="1"
                          data-columnname="name"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">الكود <i class="fa-solid fa-filter Filter-Btn" data-columnindex="2"
                          data-columnname="code"></i></div>
                    </th>
                    <th style="width: 15%;">
                      <div class="th-content">المدينة <i class="fa-solid fa-filter Filter-Btn" data-columnindex="3"
                          data-columnname="city"></i></div>
                    </th>
                    <th style="width: 18%;">
                      <div class="th-content">العنوان <i class="fa-solid fa-filter Filter-Btn" data-columnindex="4"
                          data-columnname="address"></i></div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">المخزن الرئيسي <i class="fa-solid fa-filter Filter-Btn"
                          data-columnindex="5" data-columnname="warehouse"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">الهاتف <i class="fa-solid fa-filter Filter-Btn" data-columnindex="6"
                          data-columnname="phone"></i></div>
                    </th>
                    <th style="width: 9%;">الحالة</th>
                    <th style="width: 5%;">الإجراء</th>
                  </tr>
                </thead>
                <tbody id="BranchesTable">
                  <!-- البيانات هتتحمل ديناميكي من JavaScript -->
                </tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span class="info-text" id="showingDataMetrics">عرض 0-0 من 0</span>
              <div id="PaginationPages" class="Pagination-Pages"></div>
            </div>
          </div>
        </main>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    Popup: إضافة / تعديل فرع                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="Container-PopUp-Window" id="AddNewPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle">إضافة فرع جديد</h3>
            <p id="PopupSubtitle">أدخل بيانات الفرع والمخزن المرتبط به</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddNewPopup')"><i
              class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <form id="BranchForm">
            <input type="hidden" id="BranchId" value="">
            <div class="Form-Section">
              <h4><i class="fa fa-building"></i> البيانات الأساسية</h4>
              <div class="grid">
                <div class="Field">
                  <label>كود الفرع</label>
                  <div class="input"><input type="text" id="BranchCode" placeholder="BR-XXX" readonly><i
                      class="fa fa-hashtag"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>اسم الفرع <span class="required">*</span></label>
                  <div class="input"><input type="text" id="BranchName" placeholder="اسم الفرع"><i
                      class="fa fa-building"></i></div>
                </div>
              </div>
              <div class="grid" style="margin-top: 12px;">
                <div class="Field">
                  <label>المدينة</label>
                  <div class="input"><input type="text" id="BranchCity" placeholder="المدينة"><i class="fa fa-city"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>رقم الهاتف</label>
                  <div class="input"><input type="text" id="BranchPhone" placeholder="01XXXXXXXX"><i
                      class="fa fa-phone"></i></div>
                </div>
              </div>
            </div>
            <div class="Form-Section">
              <h4><i class="fa fa-location-dot"></i> العنوان والمخزن</h4>
              <div class="grid">
                <div class="Field">
                  <label>العنوان</label>
                  <div class="input"><input type="text" id="BranchAddress" placeholder="الحي، الشارع"><i
                      class="fa fa-map"></i></div>
                </div>
                <div class="Field">
                  <label>المخزن الرئيسي</label>
                  <div class="input"><input type="text" id="BranchWarehouse" placeholder="اسم المخزن"><i
                      class="fa fa-warehouse"></i></div>
                </div>
              </div>
            </div>
            <div class="Form-Section">
              <h4><i class="fa fa-user"></i> المسؤول والحالة</h4>
              <div class="grid">
                <div class="Field">
                  <label>المسؤول عن الفرع</label>
                  <div class="input"><input type="text" id="BranchManager" placeholder="اسم المسؤول"><i
                      class="fa fa-user"></i></div>
                </div>
                <div class="Field">
                  <label>الحالة</label>
                  <div class="input SelectInput">
                    <select id="BranchStatus">
                      <option value="active">نشط</option>
                      <option value="inactive">غير نشط</option>
                      <option value="closed">مغلق</option>
                    </select>
                    <i class="fa fa-circle-check"></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="Form-Section">
              <h4><i class="fa fa-pen"></i> ملاحظات</h4>
              <div class="Field">
                <div class="input">
                  <textarea id="BranchNotes" placeholder="ملاحظات إضافية..."></textarea>
                  <i class="fa fa-pen icon-area"></i>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddNewPopup')"><i class="fa fa-xmark"></i> إلغاء</button>
          <button class="apply" onclick="saveBranch()"><i class="fa fa-save"></i> حفظ الفرع</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    Popup: عرض تفاصيل الفرع                                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window">
        <div class="PopUpWindow-Header">
          <div class="PopUpWindow-Title">
            <h3>تفاصيل الفرع</h3>
            <p><i class="fa-solid fa-hashtag"></i> <span id="DetailsCode">--</span></p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')"><i
              class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body" id="VoucherDetailsBody">
          <div class="voucher-details-container">
            <div class="Watermark">بيانات الفرع</div>

            <%- include('../Partials/letterHead') %>

              <div class="voucher-info-grid">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-green">
                    <i class="fa-solid fa-building"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">اسم الفرع</div>
                    <div class="voucher-info-value" id="DetailBranchName">--</div>
                    <div class="voucher-info-label" id="DetailBranchCode">--</div>
                  </div>
                </div>
              </div>

              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue">
                    <i class="fa-solid fa-city"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المدينة</div>
                    <div class="voucher-info-value" id="DetailCity">--</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple">
                    <i class="fa-solid fa-phone"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">رقم الهاتف</div>
                    <div class="voucher-info-value" id="DetailPhone">--</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-cyan">
                    <i class="fa-solid fa-user"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المسؤول</div>
                    <div class="voucher-info-value" id="DetailManager">--</div>
                  </div>
                </div>
              </div>

              <div class="voucher-notes-section">
                <div class="voucher-notes-title"><i class="fa-solid fa-location-dot"></i> العنوان</div>
                <div class="voucher-notes-text" id="DetailAddress">--</div>
              </div>

              <div class="voucher-info-grid Grid-2">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-green">
                    <i class="fa-solid fa-warehouse"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المخزن الرئيسي</div>
                    <div class="voucher-info-value" id="DetailWarehouse">--</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-red">
                    <i class="fa-solid fa-circle-check"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الحالة</div>
                    <div class="voucher-info-value" id="DetailStatus">--</div>
                  </div>
                </div>
              </div>

              <div class="voucher-notes-section" id="NotesSection" style="display: none;">
                <div class="voucher-notes-title"><i class="fa-solid fa-pen"></i> ملاحظات</div>
                <div class="voucher-notes-text" id="DetailNotes">--</div>
              </div>

              <div class="LetterFoot">
                <div class="Footer-Left">
                  <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                  <span id="DetailCreatedBy">تم إنشاؤها: --</span>
                </div>
                <div class="Footer-Pages">صفحة 1 من 1</div>
              </div>
          </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i> إغلاق</button>
          <button class="apply btn-print" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa fa-print"></i> طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>
        <script src="JS/Branches.js"></script>
</body>

</html>