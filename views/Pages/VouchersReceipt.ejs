<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-receipt"></i> سندات القبض</h2>
            <p>إدارة سندات قبض النقدية من العملاء والجهات</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-arrow-down"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي القبض</span>
                  <span class="num" id="TotalReceipts">47,900 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="info-text">
                  <span class="lbl">عدد السندات</span>
                  <span class="num" id="TotalVouchers">8</span>
                </div>
              </div>
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-clock"></i></div>
                <div class="info-text">
                  <span class="lbl">معلق</span>
                  <span class="num" id="PendingVouchers">1</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-users"></i></div>
                <div class="info-text">
                  <span class="lbl">عملاء</span>
                  <span class="num" id="CustomerCount">5</span>
                </div>
              </div>
            </div>

            <div class="action-buttons-group">
              <button class="Tool-Btn btn-add-customer" onclick="resetVoucherForm(); openPopUpWindow('AddNewPopup');">
                <i class="fa-solid fa-plus"></i> سند قبض جديد
              </button>
              <button class="Tool-Btn btn-excel" onclick="exportVouchersExcel()">
                <i class="fa-solid fa-file-excel"></i> تصدير Excel
              </button>
            </div>
          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="MainPerfectTable">
                <thead>
                  <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 12%;">
                      <div class="th-content">رقم السند <i class="fa-solid fa-filter Filter-Btn" data-columnindex="1"
                          data-columnname="number"></i></div>
                    </th>
                    <th style="width: 18%;">
                      <div class="th-content">الجهة <i class="fa-solid fa-filter Filter-Btn" data-columnindex="2"
                          data-columnname="entity"></i></div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">المبلغ <i class="fa-solid fa-filter Filter-Btn" data-columnindex="3"
                          data-columnname="amount"></i></div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">طريقة الدفع <i class="fa-solid fa-filter Filter-Btn" data-columnindex="4"
                          data-columnname="paymentMethod"></i></div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">الخزينة/البنك <i class="fa-solid fa-filter Filter-Btn"
                          data-columnindex="5" data-columnname="accountName"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">التاريخ <i class="fa-solid fa-filter Filter-Btn" data-columnindex="6"
                          data-columnname="date"></i></div>
                    </th>
                    <th style="width: 10%;">
                      <div class="th-content">الحالة <i class="fa-solid fa-filter Filter-Btn" data-columnindex="7"
                          data-columnname="status"></i></div>
                    </th>
                    <th style="width: 5%;">الإجراء</th>
                  </tr>
                </thead>
                <tbody id="VouchersTable"></tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span class="info-text" id="showingDataMetrics">عرض 1-3 من 8</span>
              <div id="PaginationPages" class="Pagination-Pages"></div>
            </div>
          </div>
        </main>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    نافذة إضافة سند قبض جديد                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="Container-PopUp-Window" id="AddNewPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle">سند قبض جديد</h3>
            <p id="PopupSubtitle">أدخل بيانات سند القبض بدقة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddNewPopup')"><i
              class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <form id="VoucherForm">
            <input type="hidden" id="VoucherType" value="receipt">
            <input type="hidden" id="VoucherId" value="">

            <div class="Form-Section">
              <h4><i class="fa fa-file-invoice"></i> البيانات الأساسية</h4>
              <div class="grid">
                <div class="Field">
                  <label>رقم السند</label>
                  <div class="input"><input type="text" id="VoucherNumber" disabled=""><i
                      class="fa fa-hashtag"></i></div>
                </div>
                <div class="Field">
                  <label>التاريخ</label>
                  <div class="input"><input type="date" id="VoucherDate"><i class="fa fa-calendar"></i></div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-user"></i> الجهة</h4>
              <div class="grid">
                <div class="Field" data-select="customer">
                  <label>اسم العميل</label>
                  <div class="input SelectInput">
                    <input type="text" class="select-search" placeholder="..." autocomplete="off">
                    <input type="hidden" class="select-value" id="CustomerId">
                    <i class="fa fa-user select-icon"></i>
                  </div>
                  <div class="SelectOptionDropdown">
                    <div class="select-content"></div>
                  </div>
                </div>
                <div class="Field">
                  <label>الرقم المرجعي</label>
                  <div class="input"><input type="text" id="VoucherReference" placeholder="رقم الشيك/الحوالة"><i
                      class="fa fa-hashtag"></i></div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-money-bill"></i> المبلغ</h4>
              <div class="grid">
                <div class="Field">
                  <label>المبلغ</label>
                  <div class="input"><input type="number" id="VoucherAmount" placeholder="0.00" min="0" step="0.01"><i
                      class="fa fa-coins"></i></div>
                </div>
                <div class="Field">
                  <label>المبلغ حروف</label>
                  <div class="input"><input type="text" id="VoucherAmountLetter" placeholder="المبلغ بالحروف..."><i
                      class="fa fa-money-bill"></i></div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-money-bill"></i> الدفع</h4>
              <div class="grid">
                <div class="Field">
                  <label>طريقة الدفع</label>
                  <div class="input SelectInput">
                    <select id="VoucherPaymentMethod" onchange="handlePaymentMethodChange()">
                      <option value="cash">نقداً</option>
                      <option value="transfer">تحويل بنكي</option>
                      <option value="check">شيك</option>
                    </select>
                    <i class="fa fa-credit-card"></i>
                  </div>
                </div>
                <div class="Field" data-select="cashboxes">
                  <label>الصندوق</label>
                  <div class="input SelectInput">
                    <input type="text" class="select-search" placeholder="ابحث عن مركز الصندوق..." autocomplete="off">
                    <input type="hidden" class="select-value">
                    <i class="fa fa-box select-icon"></i>
                  </div>
                  <div class="SelectOptionDropdown">
                    <div class="select-content"></div>
                  </div>
                </div>
                <div class="Field" data-select="Banks" style="display: none;">
                  <label>البنك</label>
                  <div class="input SelectInput">
                    <input type="text" class="select-search" placeholder="ابحث عن مركز البنك..." autocomplete="off">
                    <input type="hidden" class="select-value">
                    <i class="fa fa-building-columns select-icon"></i>
                  </div>
                  <div class="SelectOptionDropdown">
                    <div class="select-content"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-pen"></i> ملاحظات</h4>
              <div class="Field">
                <div class="input">
                  <textarea id="VoucherNotes" placeholder="ملاحظات إضافية..."></textarea>
                  <i class="fa fa-pen icon-area"></i>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddNewPopup')"><i class="fa fa-xmark"></i> إلغاء</button>
          <button class="apply" onclick="saveVoucher()"><i class="fa fa-save"></i> حفظ السند</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    نافذة عرض تفاصيل السند ← بيانات ديناميكية من API      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window">
        <div class="PopUpWindow-Header">
          <div class="PopUpWindow-Title">
            <h3>تفاصيل سند القبض</h3>
            <p><i class="fa-solid fa-hashtag"></i> <span id="DetailsVoucherNumber">-</span></p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')"><i
              class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body" id="VoucherDetailsBody">
          <div class="voucher-details-container">
            <div class="Watermark">سند قبض</div>

            <%- include('../Partials/letterHead') %>

              <div class="Title-Voucher">سند قبض</div>

              <!-- البيانات الأساسية -->
              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue"><i class="fa-solid fa-hashtag"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">رقم السند</div>
                    <div class="voucher-info-value" id="DetailsVoucherNumber2">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple"><i class="fa-solid fa-calendar"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">التاريخ</div>
                    <div class="voucher-info-value" id="DetailsDate">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue"><i class="fa-solid fa-pen"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">محرر السند</div>
                    <div class="voucher-info-value" id="DetailsCreatedBy">-</div>
                  </div>
                </div>
              </div>

              <!-- المبلغ -->
              <div class="voucher-amount-section">
                <div class="voucher-amount-label">المبلغ</div>
                <div class="voucher-amount-value receipt" id="DetailsAmount">-</div>
                <div class="voucher-amount-words" id="DetailsAmountWords">-</div>
              </div>

              <!-- الجهة (العميل) -->
              <div class="voucher-info-grid">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-green"><i class="fa-solid fa-user"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المسلم</div>
                    <div class="voucher-info-value" id="DetailsEntityName">-</div>
                    <div class="voucher-info-label" id="DetailsEntityCode">-</div>
                  </div>
                </div>
              </div>

              <!-- بيانات الدفع -->
              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue"><i class="fa-solid fa-credit-card"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">طريقة الدفع</div>
                    <div class="voucher-info-value" id="DetailsPaymentMethod">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple"><i class="fa-solid fa-building-columns"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الخزينة / البنك</div>
                    <div class="voucher-info-value" id="DetailsPaymentAccount">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-cyan"><i class="fa-solid fa-hashtag"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الرقم المرجعي</div>
                    <div class="voucher-info-value" id="DetailsReference">-</div>
                  </div>
                </div>
              </div>

              <!-- الحالة والقيد -->
              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-orange"><i class="fa-solid fa-circle-info"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الحالة</div>
                    <div class="voucher-info-value" id="DetailsStatus">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-green"><i class="fa-solid fa-book"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">رقم القيد المحاسبي</div>
                    <div class="voucher-info-value" id="DetailsJournalEntry">-</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-gray"><i class="fa-solid fa-barcode"></i></div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">كود الجهة</div>
                    <div class="voucher-info-value" id="DetailsEntityCode2">-</div>
                  </div>
                </div>
              </div>

              <!-- الملاحظات -->
              <div class="voucher-notes-section">
                <div class="voucher-notes-title"><i class="fa-solid fa-pen"></i> ملاحظات</div>
                <div class="voucher-notes-text" id="DetailsNotes">لا توجد ملاحظات</div>
              </div>

              <!-- التوقيعات -->
              <div class="voucher-signature-section">
                <div class="voucher-signature-box">
                  <div class="voucher-signature-line"></div>
                  <div class="voucher-signature-label">توقيع المحاسب</div>
                </div>
                <div class="voucher-signature-box">
                  <div class="voucher-signature-line"></div>
                  <div class="voucher-signature-label">توقيع المسلم</div>
                </div>
              </div>

              <div class="LetterFoot">
                <div class="Footer-Left">
                  <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                  <span id="DetailsFooterInfo">-</span>
                </div>
                <div class="Footer-Pages">صفحة 1 من 1</div>
              </div>
          </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i> إغلاق</button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa-solid fa-print"></i>
            طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="Js/Vouchers.js"></script>

</body>

</html>