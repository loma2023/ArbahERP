<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-dollar-sign"></i> قائمة الدخل</h2>
            <p>تقرير الأرباح والخسائر للفترة المالية المحددة</p>
          </div>

          <!-- Summary Cards -->
          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-arrow-trend-up"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي الإيرادات</span>
                  <span class="num" id="TotalRevenue">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-arrow-trend-down"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي المصروفات</span>
                  <span class="num" id="TotalCOGS">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-scale-balanced"></i></div>
                <div class="info-text">
                  <span class="lbl">الربح الإجمالي</span>
                  <span class="num" id="GrossProfit" style="color: var(--accent-green);">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-coins"></i></div>
                <div class="info-text">
                  <span class="lbl" id="NetProfitTxt">الصافي</span>
                  <span class="num" id="NetProfit">0</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Filters -->
          <div class="Filter-bar">
            <div class="Field">
              <label>العام السابق — من</label>
              <div class="input">
                <input type="date" id="PrevDateFrom">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>العام السابق — إلى</label>
              <div class="input">
                <input type="date" id="PrevDateTo">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>العام الحالي — من</label>
              <div class="input">
                <input type="date" id="DateFrom">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <div class="Field">
              <label>العام الحالي — إلى</label>
              <div class="input">
                <input type="date" id="DateTo">
                <i class="fa-solid fa-calendar"></i>
              </div>
            </div>
            <button class="Tool-Btn" onclick="loadIncomeStatement()">
              <i class="fa-solid fa-refresh"></i> تحديث
            </button>
            <button class="Tool-Btn btn-excel" onclick="openPrintPopup()">
              <i class="fa-solid fa-print"></i> طباعة الكشف
            </button>
            <button class="Tool-Btn" onclick="exportToExcel('MainPerfectTable', 'قائمة_الدخل')">
              <i class="fa-solid fa-file-excel"></i> Excel
            </button>
          </div>

          <!-- Table -->
          <div class="Container-Table">
            <div class="Container-Table-Body" style="height: 90vh;">
              <table class="Perfect-Table" id="MainPerfectTable">
                <thead>
                  <tr>
                    <th style="width: 28%;">البيان</th>
                    <th style="width: 12%;">الفترة الحالية</th>
                    <th style="width: 10%;">النسبة %</th>
                    <th style="width: 12%;">الفترة السابقة</th>
                    <th style="width: 10%;">النسبة %</th>
                    <th style="width: 14%;">التغير</th>
                    <th style="width: 14%;">نسبة التغير</th>
                  </tr>
                </thead>
                <tbody id="StatementBody">
                  <!-- يتم ملؤها ديناميكياً -->
                </tbody>
              </table>
            </div>
          </div>
        </main>
    </div>

    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window" style="width: 1000px; max-width: 98vw;">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle"><i class="fa-solid fa-book-open"></i> قائمة الدخل</h3>
            <p id="PopupSubtitle">معاينة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')">
            <i class="fa fa-xmark"></i></button>
        </div>
        <div class="PopUpWindow-Body">
          <div class="Watermark">قائمة الدخل</div>

          <%- include('../Partials/letterHead') %>

            <div class="Title-Voucher">قائمة الدخل</div>

            <!-- رأس كشف الحساب -->
            <!-- كروت الملخص -->
            <div class="voucher-info-grid Grid-2">
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-blue">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">من تاريخ</div>
                  <div class="voucher-info-value" id="DetailsFromDate">01-01-2026</div>
                </div>
              </div>
              <div class="voucher-info-card">
                <div class="voucher-info-icon Color-Bg-purple">
                  <i class="fa-solid fa-calendar"></i>
                </div>
                <div class="voucher-info-content">
                  <div class="voucher-info-label">الي تاريخ</div>
                  <div class="voucher-info-value" id="DetailsToDate">31-12-2026</div>
                </div>
              </div>
            </div>

            <!-- جدول كشف الحساب -->
            <div class="Container-Table2">
              <table class="Perfect-Table ledger-print-table" id="LedgerPrintTable">
                <thead>
                  <tr>
                    <th style="width: 28%;">البيان</th>
                    <th style="width: 12%;">الفترة الحالية</th>
                    <th style="width: 10%;">النسبة %</th>
                    <th style="width: 12%;">الفترة السابقة</th>
                    <th style="width: 10%;">النسبة %</th>
                    <th style="width: 14%;">التغير</th>
                    <th style="width: 14%;">نسبة التغير</th>
                  </tr>
                </thead>
                <tbody id="StatementPrintBody">
                  <!-- يملأها JS -->
                </tbody>
              </table>
            </div>

            <div class="LetterFoot">
              <div class="Footer-Left">
                <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                <span id="DetailsFooterInfo"></span>
              </div>
              <div class="Footer-Pages" id="TimeDate"></div>
            </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')"><i class="fa fa-xmark"></i> إغلاق</button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')"><i
              class="fa-solid fa-print"></i> طباعة</button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="Js/IncomeStatement.js"></script>
</body>

</html>