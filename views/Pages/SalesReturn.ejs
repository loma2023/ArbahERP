<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2>فاتورة مرتجع مبيعات</h2>
            <!-- <p>إرجاع الأصناف المباعة إلى المخزن</p> -->
          </div>

          <!-- فاتورة المبيعات الأصلية -->
          <div class="Details-Receipt">
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>رقم مرتجع المبيعات</label>
                <div class="input">
                  <input type="text" value="RET-SAL-0001" disabled="">
                  <i class="fa-solid fa-hashtag"></i>
                </div>
              </div>
              <div class="Field" id="OriginalInvoiceField">
                <label>فاتورة المبيعات الأصلية <span style="color:var(--accent-red)">*</span></label>
                <div class="input SelectInput">
                  <input type="text" id="OriginalInvoiceSearch" placeholder="ابحث برقم الفاتورة..." autocomplete="off"
                    onfocus="showOriginalInvoiceDropdown()" onkeyup="filterOriginalInvoices(this.value)">
                  <input type="hidden" id="OriginalInvoiceSelect" value="">
                  <i class="fa-solid fa-file-invoice" id="OriginalInvoiceIcon"></i>
                </div>
                <div id="OriginalInvoiceDropdown" class="SelectOptionDeopdown">
                  <div id="OriginalInvoiceDropdownContent"></div>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>تاريخ المرتجع</label>
                <div class="input">
                  <input type="date" id="ReturnDate">
                  <i class="fa-solid fa-calendar"></i>
                </div>
              </div>
              <div class="Field">
                <label>سبب الإرجاع</label>
                <div class="input SelectInput">
                  <select id="ReturnReason">
                    <option value="defective">تالف / عيوب مصنع</option>
                    <option value="wrong_item">صنف خاطئ</option>
                    <option value="customer_return">رغبة العميل</option>
                    <option value="expired">منتهي الصلاحية</option>
                    <option value="other">أخرى</option>
                  </select>
                  <i class="fa-solid fa-circle-info"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field" id="EntityField">
                <label>اسم العميل</label>
                <div class="input">
                  <input type="text" id="CustomerName" placeholder="سيظهر تلقائياً" disabled="">
                  <input type="hidden" id="CustomerId" value="">
                  <i class="fa fa-user" id="EntityIcon"></i>
                </div>
              </div>
              <div class="Field">
                <label>اسم المندوب</label>
                <div class="input">
                  <input type="text" id="SalesRepName" placeholder="سيظهر تلقائياً" disabled="">
                  <i class="fa-solid fa-user-tie"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>المخزن</label>
                <div class="input">
                  <input type="text" id="WarehouseName" placeholder="سيظهر تلقائياً" disabled="">
                  <i class="fa-solid fa-warehouse"></i>
                </div>
              </div>
              <div class="Field">
                <label>حالة المرتجع</label>
                <div class="input">
                  <input type="text" value="مفتوح" disabled="" style="color: var(--accent-orange); font-weight: 600;">
                  <i class="fa-solid fa-circle" style="color: var(--accent-orange);"></i>
                </div>
              </div>
            </div>
            <div class="Details-Receipt-Column">
              <div class="Field">
                <label>طريقة استرداد المبلغ</label>
                <div class="input SelectInput">
                  <select id="RefundMethod" onchange="handleRefundMethodChange()">
                    <option value="cash">نقداً للعميل</option>
                    <option value="credit_balance">رصيد آجل (خصم من الذمم)</option>
                    <option value="bank_transfer">تحويل بنكي</option>
                    <option value="voucher">سند صرف</option>
                  </select>
                  <i class="fa-solid fa-money-bill-transfer"></i>
                </div>
              </div>
              <div class="Field" id="CashBoxField" style="display: block;">
                <label>الخزينة / الصندوق</label>
                <div class="input SelectInput">
                  <select id="CashBoxSelect">
                    <option value="">اختر الصندوق...</option>
                    <option value="box1">صندوق 1</option>
                    <option value="box2">صندوق 2</option>
                    <option value="box3">صندوق 3</option>
                  </select>
                  <i class="fa-solid fa-box"></i>
                </div>
              </div>
              <div class="Field" id="BankField" style="display: none;">
                <label>البنك</label>
                <div class="input SelectInput">
                  <select id="BankSelect">
                    <option value="">اختر البنك...</option>
                    <option value="bank1">البنك الأهلي</option>
                    <option value="bank2">بنك الراجحي</option>
                  </select>
                  <i class="fa-solid fa-building-columns"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- جدول الأصناف -->
          <div class="Container-Table Container-Table-Receipt">
            <div class="Container-Table-Header">
              <div class="Container-AddItem">
                <div class="xxxxxxx">
                  <button class="Tool-Btn btn-add-item" onclick="openReturnItemPopup()" id="AddItemBtn" disabled>
                    <i class="fa-solid fa-plus"></i> إضافة صنف للإرجاع
                  </button>
                  <span id="OriginalInvoiceInfo" style="color: var(--text-sub); font-size: 13px; margin-right: 10px;">
                    <i class="fa-solid fa-circle-info"></i> اختر فاتورة المبيعات أولاً
                  </span>
                </div>

                <div class="xxxxxxx PriceType">
                  <div class="Field price-includes-tax-field">
                    <div class="input SelectInput">
                      <select id="PriceIncludesTax" onchange="handlePriceIncludesTaxChange()">
                        <option value="false" selected="">السعر بدون ضريبة</option>
                        <option value="true">السعر شامل الضريبة</option>
                      </select>
                      <i class="fa-solid fa-percent"></i>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="SalesReturnTable">
                <thead>
                  <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 22%;">اسم الصنف</th>
                    <th style="width: 10%;">الوحدة</th>
                    <th style="width: 7.5%;">كمية البيع</th>
                    <th style="width: 7.5%;">المرتجع</th>
                    <th style="width: 7.5%;">سعر البيع</th>
                    <th style="width: 7.5%;">الإجمالي</th>
                    <th style="width: 7.5%;">خصم %</th>
                    <th style="width: 7.5%;">ضريبة %</th>
                    <th style="width: 7.5%;">الضريبة</th>
                    <th style="width: 7.5%;">الصافي</th>
                    <th style="width: 5%;">حذف</th>
                  </tr>
                </thead>
                <tbody id="ReturnTableBody">
                  <tr>
                    <td colspan="12" class="NotFound">
                      <i class="fa-solid fa-arrow-right-to-bracket" style="margin-left: 8px;"></i>
                      اختر فاتورة المبيعات الأصلية لعرض الأصناف المتاحة للإرجاع
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span id="ItemsCount">عدد الأصناف المرتجعة: 0</span>
              <span id="TotalOriginalQty" style="margin-right: 20px; color: var(--text-sub);">إجمالي كمية البيع:
                0</span>
            </div>
          </div>

          <!-- ملخص المرتجع -->
          <div class="Control-bar Control-bar-Receipt">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-calculator"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي المرتجع</span>
                  <input type="text" id="SubTotal" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-tag"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي الخصومات</span>
                  <input type="text" id="TotalDiscount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-percent"></i></div>
                <div class="info-text">
                  <span class="lbl">خصم عام %</span>
                  <input type="number" id="DiscountPercent" class="num" value="0" min="0" max="100"
                    onchange="calculateReturnTotals()">
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-receipt"></i></div>
                <div class="info-text">
                  <span class="lbl">قيمة الخصم</span>
                  <input type="text" id="DiscountAmount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-receipt"></i></div>
                <div class="info-text">
                  <span class="lbl">بعد الخصم</span>
                  <input type="text" id="TotalAfterDiscount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-percent"></i></div>
                <div class="info-text">
                  <span class="lbl">الضريبة المستردة</span>
                  <input type="text" id="TaxAmount" class="num" value="0.00" readonly="">
                </div>
              </div>
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-wallet"></i></div>
                <div class="info-text">
                  <span class="lbl">المبلغ المسترد</span>
                  <input type="text" id="GrandTotal" class="num" value="0.00" readonly=""
                    style="color: var(--accent-red); font-weight: 700;">
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-money-bill"></i></div>
                <div class="info-text">
                  <span class="lbl">المبلغ المدفوع</span>
                  <input type="number" id="PaidAmount" class="num" value="0" min="0" step="1"
                    onchange="calculateReturnTotals()" readonly=""
                    style="background: var(--bg-hover); color: var(--text-sub);">
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-circle-exclamation"></i></div>
                <div class="info-text">
                  <span class="lbl">المتبقي للعميل</span>
                  <input type="text" id="RemainingAmount" class="num" value="0.00" readonly=""
                    style="color: var(--accent-red);">
                </div>
              </div>
            </div>

            <div class="action-buttons-group">
              <button class="Tool-Btn btn-print" onclick="printReturnInvoice()">
                <i class="fa-solid fa-print"></i> طباعة
              </button>
              <button class="Tool-Btn btn-delete-selected" onclick="clearAllReturnItems()">
                <i class="fa-solid fa-trash-can"></i> إفراغ
              </button>
              <button class="Tool-Btn btn-save" onclick="saveReturnInvoice()">
                <i class="fa-solid fa-save"></i> حفظ المرتجع
              </button>
            </div>
          </div>

        </main>
    </div>

    <!-- Popup: اختيار صنف من فاتورة المبيعات -->
    <div class="Container-PopUp-Window" id="AddReturnPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3>اختيار صنف للإرجاع</h3>
            <p>اختر الأصناف من فاتورة المبيعات الأصلية للإرجاع</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddReturnPopup')">
            <i class="fa fa-xmark"></i>
          </button>
        </div>
        <div class="PopUpWindow-Body">
          <div class="Search-Box">
            <div class="Field">
              <div class="input">
                <input type="text" id="ReturnItemSearchInput" placeholder="ابحث باسم الصنف أو الكود..."
                  onkeyup="searchReturnItems()">
                <i class="fa-solid fa-magnifying-glass"></i>
              </div>
            </div>
          </div>
          <div class="Container-Table-Body">
            <table class="Perfect-Table" id="ReturnItemsTable">
              <thead>
                <tr>
                  <th style="width: 4%;">
                    <input type="checkbox" id="SelectAllReturnItems" onchange="toggleReturnSelectAll()">
                  </th>
                  <th style="width: 8%;">#</th>
                  <th style="width: 12%;">كود الصنف</th>
                  <th style="width: 25%;">اسم الصنف</th>
                  <th style="width: 10%;">الوحدة</th>
                  <th style="width: 10%;">كمية البيع</th>
                  <th style="width: 10%;">المرتجع سابقاً</th>
                  <th style="width: 10%;">المتاح</th>
                  <th style="width: 12%;">سعر البيع</th>
                </tr>
              </thead>
              <tbody id="ReturnItemsTableBody">
              </tbody>
            </table>
          </div>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddReturnPopup')"><i class="fa fa-xmark"></i> إلغاء</button>
          <button class="apply" onclick="addSelectedReturnItems()" id="AddReturnSelectedBtn" disabled="">
            <i class="fa fa-plus"></i> إضافة للإرجاع (<span id="ReturnSelectedCount">0</span>)
          </button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>
        <script src="Assets/Js/SalesReturn.js"></script>
        

</body>

</html>