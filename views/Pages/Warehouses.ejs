<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>
    <div class="WorkSpace">

      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-warehouse"></i> المخازن</h2>
            <p>إدارة المخازن والمستودعات</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-warehouse"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي المخازن</span>
                  <span class="num" id="TotalWarehouses">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-circle-check"></i></div>
                <div class="info-text">
                  <span class="lbl">مخازن نشطة</span>
                  <span class="num" id="ActiveWarehouses">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="info-text">
                  <span class="lbl">أصناف في المخزون</span>
                  <span class="num" id="TotalProductsInStock">0</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-coins"></i></div>
                <div class="info-text">
                  <span class="lbl">قيمة المخزون</span>
                  <span class="num" id="TotalInventoryValue">0 ر.س</span>
                </div>
              </div>
            </div>

            <div class="action-buttons-group">
              <button class="Tool-Btn btn-add-Customer" onclick="resetForm(); openPopUpWindow('AddNewPopup');">
                <i class="fa-solid fa-plus"></i> إضافة مخزن
              </button>
              <button class="Tool-Btn btn-excel" onclick="exportWarehousesExcel()">
                <i class="fa-solid fa-file-excel"></i> تصدير Excel
              </button>
            </div>
          </div>

          <div class="Container-Table">
            <div class="Container-Table-Body">
              <table class="Perfect-Table" id="MainPerfectTable">
                <thead>
                  <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 25%;">
                      <div class="th-content">المخزن
                        <button class="Filter-Btn" data-columnindex="1" data-columnname="name">
                          <i class="fa-solid fa-filter"></i>
                        </button>
                      </div>
                    </th>

                    <th style="width: 15%;">
                      <div class="th-content">الفرع
                        <button class="Filter-Btn" data-columnindex="2" data-columnname="branch">
                          <i class="fa-solid fa-filter"></i>
                        </button>
                      </div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">المدير
                        <button class="Filter-Btn" data-columnindex="3" data-columnname="manager">
                          <i class="fa-solid fa-filter"></i>
                        </button>
                      </div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">الهاتف
                        <button class="Filter-Btn" data-columnindex="4" data-columnname="phone">
                          <i class="fa-solid fa-filter"></i>
                        </button>
                      </div>
                    </th>
                    <th style="width: 12%;">
                      <div class="th-content">العنوان
                        <button class="Filter-Btn" data-columnindex="5" data-columnname="address">
                          <i class="fa-solid fa-filter"></i>
                        </button>
                      </div>
                    </th>
                    <th style="width: 5%">الإجراء</th>
                  </tr>
                </thead>
                <tbody id="WarehousesTable"></tbody>
              </table>
            </div>
            <div class="Container-Table-Footer">
              <span class="info-text" id="showingDataMetrics">عرض 0-0 من 0</span>
              <div id="PaginationPages" class="Pagination-Pages"></div>
            </div>
          </div>
        </main>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    Popup: إضافة/تعديل مخزن                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <div class="Container-PopUp-Window" id="AddNewPopup">
      <div class="PopUp-Window" id="PopUp-Window">
        <div class="PopUpWindow-Header" id="WindowHeaderDrag">
          <div class="PopUpWindow-Title">
            <h3 id="PopupTitle">إضافة مخزن جديد</h3>
            <p id="PopupSubtitle">أدخل بيانات المخزن بدقة</p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('AddNewPopup')">
            <i class="fa fa-xmark"></i>
          </button>
        </div>
        <div class="PopUpWindow-Body">
          <form id="WarehouseForm">
            <input type="hidden" id="WarehouseId" value="">

            <div class="Form-Section">
              <h4><i class="fa fa-warehouse"></i> البيانات الأساسية</h4>
              <div class="grid">
                <div class="Field">
                  <label>كود المخزن</label>
                  <div class="input">
                    <input type="text" disabled id="WarehouseCode" placeholder="WH-XXX">
                    <i class="fa fa-hashtag"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>اسم المخزن <span class="Required">*</span></label>
                  <div class="input">
                    <input type="text" id="WarehouseName" placeholder="مخزن الرياض الرئيسي">
                    <i class="fa fa-warehouse"></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="Form-Section">
              <!-- ✅ قائمة الفروع -->
              <div class="Field" data-select="branch">
                <label>الفرع</label>
                <div class="input SelectInput">
                  <input type="text" class="select-search" placeholder="..." autocomplete="off">
                  <input type="hidden" class="select-value" id="BranchId">
                  <i class="fa fa-user select-icon"></i>
                </div>
                <div class="SelectOptionDropdown">
                  <div class="select-content"></div>
                </div>
              </div>
            </div>
            <div class="Form-Section">
              <h4><i class="fa fa-user-tie"></i> بيانات الاتصال</h4>
              <div class="grid">
                <div class="Field">
                  <label>مدير المخزن</label>
                  <div class="input">
                    <input type="text" id="WarehouseManager" placeholder="اسم المدير">
                    <i class="fa fa-user"></i>
                  </div>
                </div>
                <div class="Field">
                  <label>رقم الهاتف</label>
                  <div class="input">
                    <input type="text" id="WarehousePhone" placeholder="05xxxxxxxx">
                    <i class="fa fa-phone"></i>
                  </div>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-location-dot"></i> العنوان</h4>
              <div class="Field">
                <div class="input">
                  <input type="text" id="WarehouseAddress" placeholder="عنوان المخزن بالتفصيل">
                  <i class="fa fa-map"></i>
                </div>
              </div>
            </div>

            <div class="Form-Section">
              <h4><i class="fa fa-pen"></i> ملاحظات</h4>
              <div class="Field">
                <div class="input">
                  <textarea id="WarehouseNotes" placeholder="ملاحظات إضافية..."></textarea>
                  <i class="fa fa-pen icon-area"></i>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('AddNewPopup')">
            <i class="fa fa-xmark"></i> إلغاء
          </button>
          <button class="apply" onclick="saveWarehouse()">
            <i class="fa fa-save"></i> حفظ المخزن
          </button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--    Popup: تفاصيل المخزن                                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <div class="Container-PopUp-Window" id="DetailsPopup">
      <div class="PopUp-Window">
        <div class="PopUpWindow-Header">
          <div class="PopUpWindow-Title">
            <h3>تفاصيل المخزن</h3>
            <p><i class="fa-solid fa-hashtag"></i> <span id="DetailsCode">WH-001</span></p>
          </div>
          <button class="PopUpWindow-CloseBtn" onclick="closePopUpWindow('DetailsPopup')">
            <i class="fa fa-xmark"></i>
          </button>
        </div>

        <div class="PopUpWindow-Body" id="VoucherDetailsBody">
          <div class="voucher-details-container">
            <div class="Watermark">بيانات المخزن</div>

            <%- include('../Partials/letterHead') %>

              <div class="Title-Voucher">بيانات المخزن</div>

              <div class="voucher-info-grid">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue">
                    <i class="fa-solid fa-warehouse"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">اسم المخزن</div>
                    <div class="voucher-info-value" id="DetailsName">مخزن الرياض الرئيسي</div>
                    <div class="voucher-info-label" id="DetailsWhCode">WH-001</div>
                  </div>
                </div>
              </div>

              <div class="voucher-info-grid Grid-3">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-blue">
                    <i class="fa-solid fa-layer-group"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">النوع</div>
                    <div class="voucher-info-value" id="DetailsType">رئيسي</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-purple">
                    <i class="fa-solid fa-building"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">الفرع التابع</div>
                    <div class="voucher-info-value" id="DetailsBranch">فرع الرياض</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-cyan">
                    <i class="fa-solid fa-user-tie"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">المدير</div>
                    <div class="voucher-info-value" id="DetailsManager">أحمد محمد</div>
                  </div>
                </div>
              </div>

              <div class="voucher-info-grid Grid-2">
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-green">
                    <i class="fa-solid fa-phone"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">رقم الهاتف</div>
                    <div class="voucher-info-value" id="DetailsPhone">0555555555</div>
                  </div>
                </div>
                <div class="voucher-info-card">
                  <div class="voucher-info-icon Color-Bg-orange">
                    <i class="fa-solid fa-location-dot"></i>
                  </div>
                  <div class="voucher-info-content">
                    <div class="voucher-info-label">العنوان</div>
                    <div class="voucher-info-value" id="DetailsAddress">الرياض، حي الصناعية</div>
                  </div>
                </div>
              </div>

              <div class="voucher-notes-section">
                <div class="voucher-notes-title">
                  <i class="fa-solid fa-pen"></i> ملاحظات
                </div>
                <div class="voucher-notes-text" id="DetailsNotes">--</div>
              </div>

              <div class="LetterFoot">
                <div class="Footer-Left">
                  <span class="system-badge"><i class="fa-solid fa-shield-halved"></i>ArbahERP v1.0</span>
                  <span id="DetailsFooterInfo">تم إنشاؤها بواسطة: إسلام عبدالرحمن | 2024/06/09 14:30:25</span>
                </div>
                <div class="Footer-Pages">صفحة 1 من 1</div>
              </div>
          </div>
        </div>

        <div class="PopUpWindow-Footer">
          <button class="reset" onclick="closePopUpWindow('DetailsPopup')">
            <i class="fa fa-xmark"></i> إغلاق
          </button>
          <button class="apply" onclick="PrintAreaFn('#DetailsPopup .PopUpWindow-Body')">
            <i class="fa-solid fa-print"></i> طباعة
          </button>
        </div>
      </div>
    </div>

    <%- include('../Partials/filter') %>
      <%- include('../Partials/scripts') %>

        <script src="Js/Warehouses.js"></script>

</body>

</html>