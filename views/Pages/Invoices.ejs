<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <%- include('../Partials/head') %>
</head>

<body>
  <%- include('../Partials/sidebar') %>

    <div class="WorkSpace">
      <%- include('../Partials/header') %>

        <main class="WorkSpace-Content">
          <div class="Page-Title">
            <h2><i class="fa-solid fa-book-open"></i> كل الفواتير</h2>
            <p>إدارة وعرض جميع الفواتير والعمليات التجارية</p>
          </div>

          <div class="Control-bar">
            <div class="compact-cards-row">
              <div class="mini-metric-card card-orange">
                <div class="icon-box"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="info-text">
                  <span class="lbl">إجمالي الفواتير</span>
                  <span class="num" id="TotalInvoices">1,248</span>
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-arrow-trend-up"></i></div>
                <div class="info-text">
                  <span class="lbl">مبيعات</span>
                  <span class="num" id="TotalSales">856,400 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-blue">
                <div class="icon-box"><i class="fa-solid fa-arrow-trend-down"></i></div>
                <div class="info-text">
                  <span class="lbl">مشتريات</span>
                  <span class="num" id="TotalPurchases">420,150 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-purple">
                <div class="icon-box"><i class="fa-solid fa-rotate-left"></i></div>
                <div class="info-text">
                  <span class="lbl">المرتجعات</span>
                  <span class="num" id="TotalReturns">45,200 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-red">
                <div class="icon-box"><i class="fa-solid fa-percent"></i></div>
                <div class="info-text">
                  <span class="lbl">الضرائب</span>
                  <span class="num" id="TotalTax">128,450 ر.س</span>
                </div>
              </div>
              <div class="mini-metric-card card-green">
                <div class="icon-box"><i class="fa-solid fa-wallet"></i></div>
                <div class="info-text">
                  <span class="lbl">المدفوعات</span>
                  <span class="num" id="TotalPayments">680,000 ر.س</span>
                </div>
              </div>
            </div>
            <div class="action-buttons-group">
              <button class="Tool-Btn btn-excel" onclick="exportInvoicesExcel()"><i class="fa-solid fa-file-excel"></i>
                تصدير Excel</button>
            </div>
          </div>

          <div class="Filter-bar">
            <div class="Field">
              <label>نوع الفاتورة</label>
              <div class="input SelectInput">
                <select id="FilterInvoiceType">
                  <option value="all">الكل</option>
                  <option value="sales">مبيعات</option>
                  <option value="purchase">مشتريات</option>
                  <option value="sales-return">مرتجع مبيعات</option>
                  <option value="purchase-return">مرتجع مشتريات</option>
                  <option value="transfer">تحويل مخزني</option>
                </select>
                <i class="fa-solid fa-layer-group"></i>
              </div>
            </div>
            <div class="Field">
              <label>الحالة</label>
              <div class="input SelectInput">
                <select id="FilterStatus">
                  <option value="all">الكل</option>
                  <option value="paid">مدفوعة</option>
                  <option value="partial">مدفوعة جزئياً</option>
                  <option value="unpaid">غير مدفوعة</option>
                  <option value="draft">مسودة</option>
                </select>
                <i class="fa-solid fa-filter"></i>
              </div>
            </div>
            <div class="Field">
              <label>من تاريخ</label>
              <div class="input"><input type="date" id="FilterFromDate"><i class="fa-solid fa-calendar"></i></div>
            </div>
            <div class="Field">
              <label>إلى تاريخ</label>
              <div class="input"><input type="date" id="FilterToDate"><i class="fa-solid fa-calendar"></i></div>
            </div>
            <div class="Field wide">
              <label>بحث</label>
              <div class="input"><input type="text" id="FilterSearch" placeholder="رقم الفاتورة، العميل، المورد..."><i
                  class="fa-solid fa-search"></i></div>
            </div>
            <button class="Tool-Btn btn-excel" onclick="filterInvoices()"><i class="fa-solid fa-search"></i>
              بحث</button>
          </div>

